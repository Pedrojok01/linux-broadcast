#!/bin/sh
# postinst for linux-broadcast. The linux-broadcast-loopback unit, enabled and
# started by the generated section below, creates /dev/video10 now and at boot.
set -e

dpkg-maintscript-helper rm_conffile /etc/modprobe.d/linux-broadcast.conf 0.5.0-1~ -- "$@"
dpkg-maintscript-helper rm_conffile /etc/modules-load.d/linux-broadcast.conf 0.5.0-1~ -- "$@"

case "$1" in
  configure)
    # Refresh desktop / icon caches so the menu entry shows up without
    # logout. Both tools are best-effort — missing on some minimal images.
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

#DEBHELPER#

# DKMS may still be building the module on a first install; the unit retries at boot.
if [ "$1" = configure ] && [ ! -e /dev/video10 ]; then
  echo "linux-broadcast: /dev/video10 isn't available yet; it is created at the next boot (see: systemctl status linux-broadcast-loopback)" >&2
fi

exit 0
