<component type="desktop-application">
  <id>io.github.pedrojok01.LinuxBroadcast</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>LinuxBroadcast</name>
  <summary>Background-replacement virtual webcam</summary>
  <developer id="io.github.pedrojok01">
    <name>Pedrojok01</name>
  </developer>

  <description>
    <p>LinuxBroadcast blurs or replaces the background behind you on your webcam. It creates a virtual camera that Zoom, Meet, Teams, OBS, Firefox and Chrome see as a normal webcam, so it works in your usual video call and recording apps.</p>
    <p>Features:</p>
    <ul>
      <li>Two people-detection models: Robust Video Matting for the cleanest edges, and a lighter MediaPipe model for low-power machines</li>
      <li>Blur the background, replace it with an image, or pass the camera through unchanged</li>
      <li>A library of saved background images</li>
      <li>Auto-frame keeps you centered as you move</li>
      <li>Full-resolution capture: MJPEG is used automatically, so USB webcams deliver HD at 30 fps</li>
      <li>Your real camera only turns on while an app is using the virtual camera</li>
    </ul>
    <p>Requires the v4l2loopback kernel module.</p>
  </description>

  <launchable type="desktop-id">LinuxBroadcast.desktop</launchable>

  <url type="homepage">https://github.com/Pedrojok01/linux-broadcast</url>
